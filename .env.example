# Copy this file to .env and fill in your values
# NEVER commit the real .env file to version control

# Flask secret key – change this to a long random string
SECRET_KEY=change_me_to_a_long_random_secret_key_here

# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusskill
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
